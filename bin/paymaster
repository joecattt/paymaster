#!/usr/bin/env python3
"""paymaster — reconcile agent spend against budgets, with a tamper-evident trail.

  paymaster ingest            pull new ai-route events into the ledger (idempotent; auto-anchors)
  paymaster x402 <pp> <sr>    ingest an x402 PaymentPayload + SettleResponse (JSON files)
  paymaster check             evaluate budgets; exit 2 on BREACH/ORPHAN/UNPRICEABLE (gate)
  paymaster report [--days N] spend rollup by rail/provider
  paymaster consider [--days N]  provider consideration/reliability per principal
  paymaster anchor            witness the chain tail into the git-tracked anchors file
  paymaster verify            verify the hash chain + anchors; exit 2 if broken
  paymaster enroll <id>       create a principal's HMAC key (0600) for authenticated stamps
  paymaster explain <id|seq>  Decision Receipt: who/what/authority/cost/reconcile/gaps [--json]
  paymaster grant <iss> <sub>  issue a bounded, expiring capability (--usd --calls --hours --delegable)
  paymaster check-cap <file>  verify a delegation chain; exit 2 if invalid (monotonic, revocation-aware)
  paymaster revoke-cap <id>   revoke a capability (invalidates all delegations under it)
  paymaster reconcile-counters  rebuild counters from ledger, compare to cache; exit 2 on drift
  paymaster coverage [provider]  Σ(known) vs provider aggregate; exit 2 if unaccounted spend exists
  paymaster fire-drill        replay 2026 viral runaways vs your policy (SHADOW; would-have-denied card)
  paymaster license status    show trial spend vs $50 cap and whether a license is active
  paymaster license activate <key>  save a signed license key (see PAY_LINK on trial exhaustion)
"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))
from paymaster import budgets as B, pricing as P, report as R, license as L
from paymaster.adapters import airoute, x402
from paymaster.ledger import Ledger

STATE = os.path.expanduser("~/.local/state/paymaster")
LEDGER = os.path.join(STATE, "spend.jsonl")
CURSOR = os.path.join(STATE, "cursor.json")
REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
ANCHORS = os.path.join(REPO, "anchors.jsonl")

# Commands that deliver paymaster's core value (reconciling/gating real spend).
# Read-only commands (report, verify, explain, ...) stay free forever.
TRIAL_GATED = {"ingest", "check"}


def _anchor(led):
    """Witness the tail into the repo (a different trust domain) and commit."""
    import subprocess
    from datetime import datetime, timezone
    seq, h = led._tail()
    if seq == 0:
        return "nothing to anchor"
    with open(ANCHORS, "a") as f:
        f.write(json.dumps({"ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                            "seq": seq, "hash": h}) + "\n")
    subprocess.run(["git", "-C", REPO, "add", "anchors.jsonl"], capture_output=True)
    subprocess.run(["git", "-C", REPO, "commit", "-qm", f"anchor seq={seq}"],
                   capture_output=True)
    return f"anchored seq={seq} hash={h[:16]}…"


def _cursor():
    try:
        with open(CURSOR) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"airoute_rowid": 0}


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__.strip())
        return 0
    cmd, led = args[0], Ledger(LEDGER)

    if cmd == "license":
        sub = args[1] if len(args) > 1 else "status"
        if sub == "activate":
            if len(args) < 3:
                print("usage: paymaster license activate <key>")
                return 2
            try:
                payload = L.activate(args[2], STATE)
            except (ValueError, RuntimeError) as e:
                print(f"REJECTED: {e}")
                return 2
            print(f"activated: {payload['plan']} license for {payload['email']}")
            return 0
        t = L.check_trial(led, STATE)
        if t["licensed"]:
            print("licensed: yes")
        else:
            print(f"licensed: no — trial ${t['spent']:.2f}/${t['limit']:.2f} reconciled spend "
                  f"(${t['remaining']:.2f} remaining)")
        if not L.enforcement_enabled():
            print(f"enforcement: OFF ({L.ENFORCE_ENV}=0 — nothing is gated)")
        elif not t["enforceable"]:
            print("enforcement: REQUESTED but inactive — the 'cryptography' package is "
                  "missing, so no key could be verified. Failing open rather than "
                  "locking out a paid user (pip install '.[license]').")
        else:
            print("enforcement: ACTIVE")
        return 0

    if cmd in TRIAL_GATED and L.enforcement_enabled():
        t = L.check_trial(led, STATE)
        if not t["ok"]:
            print(f"TRIAL EXHAUSTED: ${t['spent']:.2f} of ${t['limit']:.2f} reconciled spend used.")
            print(f"Buy a license to keep using '{cmd}' ($49 one-time): {L.PAY_LINK}")
            print("Then: paymaster license activate <key>")
            print(f"Key won't activate, or you'd rather not pay? {L.SUPPORT_URL}")
            print(f"Read-only commands (report, verify, explain, coverage) are never gated, "
                  f"and {L.ENFORCE_ENV}=0 turns this off entirely — it's MIT source.")
            return 2
        if t["warn"]:
            print(f"NOTE: trial ${t['spent']:.2f} of ${t['limit']:.2f} used — "
                  f"'{cmd}' stops at the cap. License: {L.PAY_LINK}", file=sys.stderr)

    if cmd == "ingest":
        cur, last = _cursor(), None
        seen = led.known_ids()
        batch = []
        for rowid, rec in airoute.fetch(cur["airoute_rowid"]):
            if rec["id"] not in seen:
                batch.append(rec)
            last = rowid
        n = led.append_batch(batch)
        if last is not None:
            cur["airoute_rowid"] = last
            os.makedirs(STATE, exist_ok=True)
            with open(CURSOR, "w") as f:
                json.dump(cur, f)
        print(f"ingested {n} new records (cursor rowid={cur['airoute_rowid']})")
        if n:
            print(_anchor(led))
        return 0

    if cmd == "x402":
        with open(args[1]) as f:
            pp = json.load(f)
        with open(args[2]) as f:
            sr = json.load(f)
        rec = x402.parse(pp, sr, principal=(args[3] if len(args) > 3 else "agent"))
        if rec["id"] in led.known_ids():
            print(f"duplicate, skipped: {rec['id']}")
            return 0
        led.append(rec)
        print(f"recorded {rec['currency']} {rec['usd']} -> {rec['provider']} ({rec['evidence']})")
        return 0

    if cmd == "check":
        findings, _ = B.evaluate(list(led.records()), B.load(), P.load(),
                                 tz=B.load_tz())
        gate = [f for f in findings if f["kind"] in ("BREACH", "UNPRICEABLE", "ORPHAN")]
        orphans = [f for f in findings if f["kind"] == "ORPHAN"]
        for f in gate:
            print(f"{f['kind']}: {f.get('budget','')} {f['detail']}")
        if orphans:
            print(f"ORPHAN spend (fails gate): {len(orphans)} records match no budget "
                  f"(first: {orphans[0]['detail']} [{orphans[0]['evidence']}])")
        if not findings:
            print("clean: all spend inside budget scopes and limits")
        return 2 if gate else 0

    if cmd == "report":
        days = int(args[args.index("--days") + 1]) if "--days" in args else None
        agg = R.rollup(list(led.records()), P.load(), days)
        print(R.render(agg, f"agent spend — {'last %dd' % days if days else 'all time'}"))
        return 0

    if cmd == "verify":
        from paymaster.ledger import verify_anchors
        ok, msg = led.verify()
        print(("OK: " if ok else "TAMPERED: ") + msg)
        ok2, msg2 = verify_anchors(led, ANCHORS)
        print(("OK: " if ok2 else "TAMPERED: ") + msg2)
        return 0 if (ok and ok2) else 2

    if cmd == "anchor":
        print(_anchor(led))
        return 0

    if cmd == "consider":
        days = int(args[args.index("--days") + 1]) if "--days" in args else 7
        from datetime import datetime, timedelta, timezone
        cutoff = (datetime.now(timezone.utc) - timedelta(days=days)).isoformat()
        # rank semantics live in the source telemetry; derive there, honestly
        import sqlite3
        db = os.path.expanduser("~/.local/state/ai-route/routing.db")
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        print(f"provider consideration — last {days}d (rank 0 = preferred seat)")
        print(f"{'provider':<12}{'tried@0':>9}{'ok@0':>7}{'pref reliability':>18}{'rescues(rank>0 ok)':>20}")
        for prov, t0, ok0, resc in con.execute(
            "SELECT provider, SUM(CASE WHEN fallback_rank=0 THEN 1 ELSE 0 END),"
            " SUM(CASE WHEN fallback_rank=0 AND ok=1 THEN 1 ELSE 0 END),"
            " SUM(CASE WHEN fallback_rank>0 AND ok=1 THEN 1 ELSE 0 END)"
            " FROM events WHERE ts >= ? AND provider != '' GROUP BY provider"
            " ORDER BY 2 DESC", (cutoff,)):
            rel = f"{ok0/t0*100:5.1f}%" if t0 else "    —"
            print(f"{prov:<12}{t0 or 0:>9}{ok0 or 0:>7}{rel:>18}{resc or 0:>20}")
        con.close()
        print("\nThis is the seed of the procurement-intelligence dataset:"
              " who was preferred, who actually delivered, who rescued.")
        return 0

    if cmd == "fire-drill":
        # Replay the viral 2026 runaway shapes against the current policy and show
        # what the gate WOULD have decided. SHADOW: blocks nothing, claims nothing
        # it didn't do. The card is built to be screenshotted, and to be honest.
        from paymaster import gate as _g, budgets as _b
        budgets = _b.load(); tz = _b.load_tz()
        SCENARIOS = [
            ("recursive-loop (HN $6,531 AWS)", "loop-agent", 0.02, 900),   # cheap calls, no stop
            ("'$250 cap' that hit $10,138",    "capped-agent", 0.85, 300),
            ("single $30,141 Bedrock run",     "batch-agent", 30141.0, 1),
        ]
        print("PAYMASTER FIRE-DRILL — would the gate have caught 2026's viral runaways?")
        print("(SHADOW replay against your policy; blocks nothing; 'WOULD-HAVE' is literal)\n")
        import datetime as _dt
        for name, principal, per_call, n in SCENARIOS:
            snap = _g.Snapshot(budgets, tz).build([])
            # give this principal a demo budget so the drill is meaningful
            demo = budgets + [{"id":"drill","scope":{"principal":principal},"window":"day","limit_usd":50.0}]
            snap = _g.Snapshot(demo, tz).build([])
            ts = _dt.datetime.now(_dt.timezone.utc)
            spent = 0.0; denied_at = None
            from paymaster.pricing import price as _price
            # we drive usd directly via a synthetic record stream
            cum = 0.0
            for i in range(1, n+1):
                # decide BEFORE the call using cumulative-usd projection
                d = snap.decide(principal=principal, provider="openai", tokens=0, calls=1, now=ts)
                # emulate usd budget: track cumulative, deny when over the demo $50 limit
                if cum + per_call > 50.0 and denied_at is None:
                    denied_at = i
                cum += per_call
                snap.advance(principal, "openai", 0, 1, ts.isoformat())
            actual = per_call * n
            if denied_at:
                stopped_at = per_call * denied_at
                saved = actual - stopped_at
                print(f"  ⚠ WOULD-HAVE-DENIED  {name}")
                print(f"    agent={principal}  would-stop at call #{denied_at} (${stopped_at:,.2f} spent)")
                print(f"    actual runaway reached ${actual:,.2f}  ->  ${saved:,.2f} would-have-been-prevented")
                print(f"    policy=drill($50/day)  mode=SHADOW (nothing blocked)  ts={ts.isoformat(timespec='seconds')}\n")
            else:
                print(f"  ✓ within policy  {name}: ${actual:,.2f} under the $50 demo limit\n")
        print("CAVEATS (printed so the card can't lie):")
        print("  - SHADOW mode: this BLOCKS NOTHING. It shows what an enforced gate would do.")
        print("  - An agent holding RAW provider keys bypasses the gate entirely (route via gateway to enforce).")
        print("  - Infra runaways (the $6,531 was CloudFormation, not LLM) need a gate at THAT boundary too.")
        return 0

    if cmd == "coverage":
        # Compare Σ(known provider cost) to the provider's own aggregate total.
        import urllib.request as _u, json as _j
        from paymaster import coverage as _C
        from paymaster.pricing import price as _price, load as _load
        prov = args[1] if len(args) > 1 else "openrouter"
        agg = None
        if prov == "openrouter":
            key = ""
            envp = os.path.expanduser("~/.config/ai-bridge/env")
            if os.path.exists(envp):
                for ln in open(envp):
                    if ln.startswith("OPENROUTER_API_KEY="):
                        key = ln.split("=", 1)[1].strip().strip('"').strip("'")
            try:
                rq = _u.Request("https://openrouter.ai/api/v1/credits",
                                headers={"Authorization": f"Bearer {key}"})
                agg = float(_j.load(_u.urlopen(rq, timeout=15))["data"]["total_usage"])
            except Exception as e:
                print(f"coverage: could not fetch provider aggregate: {e}")
        table = _load(); known = 0.0
        for r in led.records():
            if r.get("provider") == prov:
                known += (_price(r, table) or 0.0)
        res = _C.assess(known, agg)
        print(f"coverage[{prov}]: known=${known:.6f} provider_aggregate="
              f"{'$%.6f' % agg if agg is not None else 'N/A'} -> {res['verdict']} (gap={res['gap']})")
        print(f"  {res['note']}")
        return 0 if res["verdict"] in (_C.COVERED, _C.NO_AGGREGATE) else 2

    if cmd == "grant":
        # paymaster grant <issuer> <subject> --provider X --usd N --calls N --hours H [--delegable]
        from paymaster import capability as _cap
        from datetime import datetime, timedelta, timezone
        a = args[1:]
        if len(a) < 2:
            print("usage: paymaster grant <issuer> <subject> [--provider P] [--usd N] [--calls N] [--hours H] [--delegable]", file=sys.stderr)
            return 1
        def _opt(flag, cast=str, default=None):
            return cast(a[a.index(flag)+1]) if flag in a else default
        scope = {}
        if _opt("--provider"): scope["provider"] = _opt("--provider")
        exp = (datetime.now(timezone.utc) + timedelta(hours=_opt("--hours", float, 1.0))).isoformat(timespec="seconds")
        cap = _cap.issue(a[0], a[1], scope=scope, expires=exp,
                         max_usd=_opt("--usd", float), max_calls=_opt("--calls", int),
                         allow_delegate="--delegable" in a)
        print(json.dumps(cap, indent=1))
        return 0

    if cmd == "check-cap":
        # paymaster check-cap <chain.json>   (file: JSON list of capability tokens)
        from paymaster import capability as _cap
        with open(args[1]) as f:
            chain = json.load(f)
        v = _cap.verify_chain(chain if isinstance(chain, list) else [chain])
        print(json.dumps(v, indent=1))
        return 0 if v["valid"] else 2

    if cmd == "revoke-cap":
        from paymaster import capability as _cap
        _cap.revoke(args[1], " ".join(args[2:]) or "operator revocation")
        print(f"revoked {args[1]} (cascades to all delegations under it)")
        return 0

    if cmd == "explain":
        # The product, in one command: an auditable answer to "what did the
        # autonomous system just do?" Assembled ONLY from existing telemetry.
        if len(args) < 2:
            print("usage: paymaster explain <record-id-prefix|ledger-seq>", file=sys.stderr)
            return 1
        from paymaster import receipt as _R
        target = args[1]
        found = seq = None
        if not os.path.exists(LEDGER):
            print("no ledger yet — run `paymaster ingest` (or `paymaster x402 ...`) first", file=sys.stderr)
            return 1
        with open(LEDGER) as f:
            for line in f:
                if not line.strip():
                    continue
                row = json.loads(line)
                if str(row["seq"]) == target or row["rec"]["id"].startswith(target):
                    found, seq = row["rec"], row["seq"]
        if not found:
            print(f"no ledger record matching {target!r}", file=sys.stderr)
            return 1
        decisions = []
        dpath = os.path.join(STATE, "decisions.jsonl")
        if os.path.exists(dpath):
            with open(dpath) as f:
                decisions = [json.loads(l) for l in f if l.strip()]
        # consideration chain from routing telemetry (same principal, +/-120s)
        consideration = None
        try:
            import sqlite3
            from datetime import datetime, timedelta
            t0 = datetime.fromisoformat(found["ts"])
            con = sqlite3.connect("file:" + os.path.expanduser(
                "~/.local/state/ai-route/routing.db") + "?mode=ro", uri=True)
            rows = con.execute(
                "SELECT provider, ok, fallback_rank FROM events WHERE caller=? "
                "AND ts BETWEEN ? AND ? ORDER BY ts",
                (found["principal"], (t0 - timedelta(seconds=120)).isoformat(),
                 (t0 + timedelta(seconds=120)).isoformat())).fetchall()
            con.close()
            if rows:
                consideration = [{"provider": p, "ok": bool(o), "rank": r} for p, o, r in rows]
        except Exception:
            pass
        r = _R.build(found, seq=seq, decisions=decisions, consideration=consideration)
        if "--json" in args:
            print(json.dumps(r, indent=1))
        else:
            print(_R.render(r))
        return 0

    if cmd == "reconcile-counters":
        from paymaster import counters as _C
        ok, msg = _C.reconcile(B.load(), B.load_tz())
        print(("OK: " if ok else "MISMATCH: ") + msg)
        return 0 if ok else 2

    if cmd == "enroll":
        from paymaster import principal
        if len(args) < 2:
            print("usage: paymaster enroll <principal_id>", file=sys.stderr)
            return 1
        path = principal.enroll(args[1])
        print(f"enrolled {args[1]} -> {path} (0600)")
        return 0

    print(f"unknown command: {cmd}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
